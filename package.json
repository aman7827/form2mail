  "license": "MIT",
  "type": "module",
  "main": "index.js",

  "repository": {
    "type": "git",
    "url": "git+https://github.com/aman7827/form2mail.git"
  },

  "homepage": "https://github.com/aman7827/form2mail",

  "bugs": {
    "url": "https://github.com/aman7827/form2mail/issues"
  },

  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },

  "dependencies": {
